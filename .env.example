# =============================================================================
#  ORION — .env.example
# -----------------------------------------------------------------------------
#  Copy this file to `.env` (which is git-ignored) and fill in real values.
#
#  RULES:
#    1. NEVER commit `.env` — only `.env.example`.
#    2. Replace every `REPLACE_ME_*` placeholder with a real value.
#    3. Comments tell you what each variable is and where to obtain it.
#    4. The schema in `packages/shared/src/env.ts` validates these at boot.
#       If a required variable is missing, the process EXITS with code 1.
#
#  TIP: generate strong random secrets with:
#       openssl rand -hex 32
# =============================================================================


# -----------------------------------------------------------------------------
#  Runtime
# -----------------------------------------------------------------------------

# One of: development | test | staging | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
#  Database — PostgreSQL 17
#  Local: docker compose up postgres   (brought up in Sprint 2)
#  Prod:  DigitalOcean Managed Postgres → Connection Details → "Connection string"
#         https://cloud.digitalocean.com/databases
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://orion:orion@localhost:5432/orion_dev?schema=public

# Optional — separate database used by Testcontainers / integration tests.
# Leave commented out for development, set in CI.
# DATABASE_URL_TEST=postgresql://orion:orion@localhost:5433/orion_test?schema=public


# -----------------------------------------------------------------------------
#  Cache / Queue / Pub-Sub — Redis 8 (or Valkey)
#  Local: docker compose up redis      (brought up in Sprint 2)
#  Prod:  DigitalOcean Managed Redis → Connection Details → "Connection string"
#         (uses rediss:// for TLS in production)
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
#  Authentication — JWT
#  Generate each one independently. They MUST be different.
#    openssl rand -hex 32
# -----------------------------------------------------------------------------

JWT_ACCESS_SECRET=REPLACE_ME_with_64_hex_characters_from_openssl_rand_hex_32
JWT_REFRESH_SECRET=REPLACE_ME_with_a_DIFFERENT_64_hex_characters_value

# Token lifetimes in seconds (defaults shown — override only with reason)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600


# -----------------------------------------------------------------------------
#  Cryptography — encryption key for at-rest secrets (e.g. tenant WhatsApp tokens)
#    openssl rand -hex 32
# -----------------------------------------------------------------------------

ENCRYPTION_KEY=REPLACE_ME_with_64_hex_characters_for_AES_256_GCM


# -----------------------------------------------------------------------------
#  Meta — WhatsApp Cloud API
#  Get them at: https://developers.facebook.com/apps
#    1. Create / select your Meta App
#    2. Settings → Basic → "App Secret" (click "Show")  → META_APP_SECRET
#    3. WhatsApp → Configuration → "Webhook" → "Verify token"
#       (you choose any random string ≥ 20 chars; that exact value goes here)
#    4. Graph API version (v21.0 as of 2026-04 is the long-lived current LTS)
# -----------------------------------------------------------------------------

META_APP_SECRET=REPLACE_ME_meta_app_secret_from_facebook_dev_console
META_VERIFY_TOKEN=REPLACE_ME_random_string_at_least_20_chars_you_pick
META_GRAPH_API_VERSION=v21.0


# -----------------------------------------------------------------------------
#  Anthropic — Claude API
#  Get it at: https://console.anthropic.com/settings/keys
#    Settings → API Keys → "Create Key"  (key only shown ONCE — save it now)
#  NOTE: this is independent of any Claude Max subscription.
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_with_your_key_starting_sk_ant_api03

# Default models (latest-stable policy — adjust only via ADR)
ANTHROPIC_MODEL_TRIAGE=claude-sonnet-4-6
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5


# -----------------------------------------------------------------------------
#  Sentry — error tracking
#  Get it at: https://sentry.io
#    Settings → Projects → <your project> → "Client Keys (DSN)"
#  Optional in development; REQUIRED in production (validation enforced).
# -----------------------------------------------------------------------------

# SENTRY_DSN=https://REPLACE_ME@oREPLACE.ingest.sentry.io/REPLACE


# -----------------------------------------------------------------------------
#  HTTP — CORS
#  Comma-separated list of origins allowed to call the API.
#  In production, every entry MUST start with https:// (validation enforced).
# -----------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookie domain (refresh-token httpOnly cookie). Use ".orion.io" in production.
COOKIE_DOMAIN=localhost


# -----------------------------------------------------------------------------
#  Feature flags — MVP
# -----------------------------------------------------------------------------

# When true, the bot will auto-reply with its suggested response (no human review).
# Default: false. Tenants can override per-conversation in BotConfig.
FEATURE_AUTO_REPLY_ENABLED=false

# When true, every inbound message is sent to Claude for triage.
# Default: true. Tenants can disable in BotConfig.
FEATURE_AI_TRIAGE_ENABLED=true
