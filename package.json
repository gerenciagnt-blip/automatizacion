{
  "name": "orion",
  "version": "0.1.0",
  "private": true,
  "description": "Orion — Multi-tenant conversational CRM for WhatsApp Cloud API. AI-native, omnichannel-ready.",
  "license": "UNLICENSED",
  "author": {
    "name": "Jhon Alexander Sepulveda",
    "email": "gerencia.gnt@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gerenciagnt-blip/automatizacion.git"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "pnpm -r --filter=./apps/* build",
    "dev": "pnpm --filter @orion/api dev",
    "start": "pnpm --filter @orion/api start",
    "test": "pnpm -r --filter=./apps/* --filter=./packages/* test",
    "test:coverage": "pnpm --filter @orion/api test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ci": "biome ci .",
    "db:generate": "pnpm --filter @orion/api db:generate",
    "db:migrate": "pnpm --filter @orion/api db:migrate",
    "db:reset": "pnpm --filter @orion/api db:reset",
    "db:studio": "pnpm --filter @orion/api db:studio",
    "db:format": "pnpm --filter @orion/api db:format",
    "docker:up": "docker compose -f ops/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f ops/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f ops/docker/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f ops/docker/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
